<!--
  Suricata Log Ingestion
  Add inside <ossec_config> on the AGENT running Suricata.
  Path: /var/ossec/etc/ossec.conf

  Lets the Wazuh agent tail Suricata's JSON alert log and forward it
  to the manager for correlation alongside host-based events.
-->
<ossec_config>
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/suricata/eve.json</location>
  </localfile>
</ossec_config>
