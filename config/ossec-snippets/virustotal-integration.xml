<!--
  VirusTotal Integration + Active Response
  Add inside <ossec_config> on the MANAGER.
  Path: /var/ossec/etc/ossec.conf

  Requires:
    - A free VirusTotal API key: https://www.virustotal.com/
    - scripts/active-response/remove-threat.sh deployed on the agent
    - Matching FIM directory monitoring enabled (see fim.xml)
-->
<ossec_config>
  <integration>
    <name>virustotal</name>
    <api_key><YOUR_VIRUSTOTAL_API_KEY></api_key>
    <rule_id>100200,100201</rule_id>
    <alert_format>json</alert_format>
  </integration>

  <active-response>
    <disabled>no</disabled>
    <command>remove-threat</command>
    <location>local</location>
    <rules_id>87105</rules_id>
  </active-response>
</ossec_config>
